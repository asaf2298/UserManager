{
  "rewrites": [
    { "source": "/:user/manifest.json", "destination": "/api/manifest" },
    { "source": "/:user/catalog/:type/:id.json", "destination": "/api/catalog" },
    { "source": "/:user/catalog/:type/:id/:extra*.json", "destination": "/api/catalog" },
    { "source": "/:user/catalog/:type/:id", "destination": "/api/catalog" },
    { "source": "/:user/catalog/:type/:id/:extra*", "destination": "/api/catalog" },
    { "source": "/:user/meta/:type/:id.json", "destination": "/api/meta" },
    { "source": "/:user/meta/:type/:id", "destination": "/api/meta" },
    { "source": "/:user/stream/:type/:id.json", "destination": "/api/stream" },
    { "source": "/:user/stream/:type/:id", "destination": "/api/stream" },
    { "source": "/:user/subtitles/:type/:id.json", "destination": "/api/subtitles" },
    { "source": "/:user/subtitles/:type/:id", "destination": "/api/subtitles" },
    { "source": "/:user/subtitles/:type/:id/:extra*.json", "destination": "/api/subtitles" },
    { "source": "/:user/subtitles/:type/:id/:extra*", "destination": "/api/subtitles" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
